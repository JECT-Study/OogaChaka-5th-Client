{
  "name": "oogachaka-5th-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:web": "next build --webpack",
    "cap:sync": "bun run build:web && bunx cap sync",
    "ios": "bun run build:web && bunx cap sync ios && node scripts/run-ios.mjs",
    "ios:dev": "node scripts/run-ios.mjs --live",
    "cap:open:ios": "bunx cap open ios",
    "cap:open:android": "bunx cap open android",
    "start": "next start",
    "lint": "oxlint --react-plugin --nextjs-plugin --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@tanstack/react-query": "^5.105.3",
    "dayjs": "^1.11.23",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  }
}
