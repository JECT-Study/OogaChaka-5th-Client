{
  "name": "oogachaka-5th-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:web": "next build --webpack",
    "cap:sync": "bun run build:web && bunx cap sync",
    "ios": "bun run build:web && bunx cap sync ios && bunx cap run ios",
    "cap:open:ios": "bunx cap open ios",
    "cap:open:android": "bunx cap open android",
    "start": "next start",
    "lint": "oxlint --react-plugin --nextjs-plugin --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@tanstack/react-query": "^5.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
